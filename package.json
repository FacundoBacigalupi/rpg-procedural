{
  "name": "rpg-procedural",
  "version": "0.0.0",
  "private": true,
  "description": "Simulador de vida de fantasía procedural con mundo determinista y LLM en los bordes",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "typecheck": "tsc && tsc -p src/ui/web/client",
    "lint": "biome check . && depcruise src test --config .dependency-cruiser.cjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev": "node src/ui/cli/main.ts",
    "worldgen": "node src/tools/worldgen/main.ts",
    "sim": "node src/tools/sim/main.ts",
    "sim:batch": "node src/tools/sim/batch-main.ts",
    "sim:diff": "node src/tools/sim/diff-main.ts",
    "autoplay": "node src/ui/autoplay-main.ts",
    "sim:tune": "node src/tools/sim/tune-main.ts",
    "llm-bench": "node src/tools/llm-bench/main.ts",
    "web": "node src/ui/web/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.7.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  }
}
